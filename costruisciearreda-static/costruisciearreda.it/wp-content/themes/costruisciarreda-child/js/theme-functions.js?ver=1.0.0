	jQuery( ".iconSearch a" ).on( "click", function() {
	   jQuery('.searchBox').slideToggle(200);
	   jQuery(this).toggleClass('isOpen');
	});

	jQuery( '.searchBox' ).focusout(function() {
	   jQuery('.searchBox').slideUp(200);
	   jQuery('.iconSearch a').removeClass('isOpen');
	});

	jQuery( '.searchBox i' ).on( "click", function() {
	   jQuery('.searchBox').slideUp(200);
	   jQuery('.iconSearch a').removeClass('isOpen');
	});

	//eventi al click per lo zoom----------------------------------------------------------------------------------
    jQuery("*[data-zoom *= 'true']").on("click", function () {
        zoomImg(this);
    });	
    jQuery(".boxModal, .closeModal").on("click", function () {
        closeZoomImg();
    });

	jQuery( '.iconCart' ).on( "click", function() {
	   jQuery('.miniCart').fadeToggle(300);
	});	    

	// INIT DEGLI SLIDER ------------------------------------------------------------------------------------------
	// simple slider
	jQuery('.carousel').carousel({
	  interval: 0,
	  ride: true
	});

	function controlMegamenu($status, $menu){
		if( $status == 'open' ){
			jQuery('body').find('.boxMegaMenu'+$menu+' ').fadeIn(300);
		}
		if( $status == 'close' ){
			jQuery('body').find('.boxMegaMenu').fadeOut(100);
		}		
	}

	//servizi
	jQuery( 'body' ).on( "mouseenter", 'li.megamenu.servizi a' , function() { controlMegamenu('open','.servizi'); });
	jQuery( '.preHeader' ).on( "mouseenter" , function() { controlMegamenu('close'); }); 	
	jQuery( 'li.menu-item' ).not('li.megamenu.servizi').on( "mouseenter" , function() { controlMegamenu('close'); }); 	 	
	//referenze
	jQuery( 'body' ).on( "mouseenter", 'li.megamenu.referenze a' , function() { controlMegamenu('open','.referenze'); });
	jQuery( '.preHeader' ).on( "mouseenter" , function() { controlMegamenu('close'); }); 	
	jQuery( 'li.menu-item' ).not('li.megamenu.referenze').on( "mouseenter" , function() { controlMegamenu('close'); }); 	 		
	//partner
	jQuery( 'body' ).on( "mouseenter", 'li.megamenu.partner a' , function() { controlMegamenu('open','.partner'); });
	jQuery( '.preHeader' ).on( "mouseenter" , function() { controlMegamenu('close'); }); 	
	jQuery( 'li.menu-item' ).not('li.megamenu.partner').on( "mouseenter" , function() { controlMegamenu('close'); }); 	 	


	jQuery( 'body' ).on( "mouseleave", '.boxMegaMenu' , function() {
	   controlMegamenu('close');
	});





	jQuery( window ).scroll(function(){
	  stickyHeader();
	});


});	


