var rootHost = document.location.host;
if(rootHost == 'areadev.it'){
	var rootPath = 'http://'+rootHost+'/edilcomgru/wp-content/themes/edilcom-child/';
}
else if( rootHost == 'vibegotest2.it' ){
	var rootPath = 'https://'+rootHost+'/edilcomgru/wp-content/themes/edilcom-child/';
}
else if( rootHost == 'www.edilcomgru.com' ){
	var rootPath = 'https://'+rootHost+'/wp-content/themes/edilcom-child/';
}
$path = rootPath+'includes/';
var imgPath = rootPath+'images/';

function openPopUp(url, title) { 
	newin = window.open(url, title,'scrollbars=no,resizable=yes, width=400,height=400,status=no,location=no,toolbar=no');
}

//funzioni zoom -------------------------------------------------------
function zoomImg($element) {
    var src = jQuery($element).attr('data-src');
    jQuery('.boxModal img').attr('src', src);
    $html = '<div class="boxImgModal"><img src="'+src+'"/></div>';
    jQuery('.boxModal').append($html);    
    jQuery('.boxModal').fadeIn(300);
}
function closeZoomImg() {
    jQuery('.boxModal').fadeOut(300);
    jQuery('.boxModal img').attr('src', '');
    jQuery('.boxModal img').remove();
    jQuery('.boxImgModal').remove();
}
//funzioni zoom-------------------------------------------------------

function preloader($status, $container = null){
	var html = '<div class="preloader"><img src="'+imgPath+'preloader.svg"></div>';
	if($status == 'show'){
		jQuery('body').find($container).prepend(html);
	}
	if($status == 'hide'){
		jQuery('body '+$container).find('.preloader').delay(300).remove();
	}
}

function loadReferenzeFilter($el){
	jQuery('.boxTerms li a').removeClass('active');
	jQuery($el).addClass('active');
	var termID = jQuery($el).data('id');
	jQuery.ajax({
		type:'post',
		data:{
			taxonomy : 'cat_referenze',
			term_id : termID
		},      
		url:$path+'ajax/load-referenze.php',
		beforeSend: function(){
			jQuery('.boxListReferenze .boxAjaxResults .ajaxResults').hide();
			preloader('show', '.boxListReferenze .boxAjaxResults');
		},                
		complete:function(){
			preloader('hide', '.boxListReferenze .boxAjaxResults');
			jQuery('.boxListReferenze .boxAjaxResults .ajaxResults').fadeIn(200);	
		},
		success:function(response) {
			jQuery('body').find('.boxListReferenze .boxAjaxResults .ajaxResults').html(response);
		}
	});
}

function stickyHeader(){
	var obj = jQuery('body').find('.desktopHeader .headerType1, .mobileHeader'); 
	var h_header = obj.height();
	if( jQuery(window).scrollTop() >= 50){
		obj.addClass('sticky');
	}
	else{
		obj.removeClass('sticky');
	}
	//console.log(jQuery(window).scrollTop());
}


