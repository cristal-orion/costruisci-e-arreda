---
/**
 * Layout del sito: `BaseLayout` più header e footer.
 * Le pagine usano questo; `BaseLayout` resta per i casi senza cornice
 * (thank-you page essenziali, pagine di controllo interne).
 */
import type { ComponentProps } from 'astro/types';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BloccoContatti from '../components/BloccoContatti.astro';

type PropsBase = ComponentProps<typeof BaseLayout>;

/** Le prop di `BaseLayout` (titolo, SEO, dati strutturati) passano tali e quali. */
interface Props extends PropsBase {
  /**
   * Il blocco "Realizza con noi il tuo progetto" sta su **ogni** pagina
   * dell'originale, sopra il footer. Si toglie solo dove sarebbe fuori posto
   * (la pagina di controllo interna, le thank-you page).
   */
  bloccoContatti?: boolean;
}

const { bloccoContatti = true, ...base }: Props = Astro.props;
---

<BaseLayout {...base}>
  <slot name="head" slot="head" />
  <Header slot="header" pathname={Astro.url.pathname} />
  <slot />
  {bloccoContatti && <BloccoContatti />}
  <Footer slot="footer" />
</BaseLayout>
