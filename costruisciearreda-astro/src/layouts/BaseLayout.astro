---
/**
 * Guscio HTML di ogni pagina.
 *
 * Risolve alla radice quattro problemi del sito originale:
 *  - `description` è obbligatoria: nel mirror mancava su 49 pagine su 56;
 *  - `<h1>` unico: il layout non ne stampa nessuno, lo mette la pagina (una volta);
 *  - canonical e og:url assoluti sul dominio nuovo, non i relativi rotti del mirror;
 *  - viewport senza `user-scalable=no` / `maximum-scale` (WCAG 1.4.4).
 */
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { site } from '../data/site';
import Consenso from '../components/Consenso.astro';
import { rami } from '../data/rami';
import { immagine } from '../lib/immagini';
import {
  BRICIOLE_SEZIONE,
  bricioleLd,
  grafo,
  organizzazioneLd,
  paginaLd,
  sitoLd,
  titoloPagina,
  type Briciola,
  type TipoPagina,
} from '../lib/seo';

interface Props {
  /** Titolo della pagina, senza il suffisso del nome sito. */
  title: string;
  /**
   * `<title>` completo, da usare verbatim invece di comporre
   * "titolo - nome sito". Serve dove l'originale non seguiva quello schema:
   * gli 8 articoli del blog hanno un `<title>` senza il nome del sito.
   */
  titleFull?: string;
  /** Obbligatoria: nessuna pagina può uscire senza meta description. */
  description: string;
  /**
   * Immagine per Open Graph e per i dati strutturati. Se manca si usa la foto
   * del primo ramo: una pagina condivisa senza immagine esce come un link nudo
   * su WhatsApp e LinkedIn, e prima succedeva su 45 pagine su 53.
   */
  image?: ImageMetadata;
  /** Testo alternativo dell'immagine di anteprima. */
  imageAlt?: string;
  /** Nome della pagina nelle briciole di pane, se diverso da `title`. */
  nomeBreve?: string;
  /**
   * Le pagine che stanno fra la homepage e questa, per le briciole di pane. Se
   * manca si ricavano dalla sezione (`/services/…` → Servizi); `[]` = figlia
   * diretta della homepage.
   */
  briciole?: Briciola[];
  /** Tipo schema.org della pagina: `AboutPage`, `ContactPage`, … */
  tipoPagina?: TipoPagina;
  /** Nodi JSON-LD propri della pagina, aggiunti al grafo comune. */
  schema?: Record<string, unknown>[];
  /** Data di pubblicazione (ISO): la pagina è un articolo, per Open Graph. */
  pubblicato?: string;
  /** Da mettere a true sulle thank-you page e sugli archivi thin. */
  noindex?: boolean;
  /** Classe extra sul body, per le pagine che ne hanno bisogno. */
  bodyClass?: string;
}

const {
  title,
  titleFull,
  description,
  image,
  imageAlt,
  nomeBreve,
  briciole,
  tipoPagina,
  schema = [],
  pubblicato,
  noindex = false,
  bodyClass,
} = Astro.props;

const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site).href;
const fullTitle = titoloPagina(titleFull ?? title);

/* L'anteprima social va in JPEG 1200×630, ritagliata al centro: è il formato
   che tutti i client leggono (WhatsApp e alcuni lettori di LinkedIn ignorano
   il WebP) e il rapporto che Facebook e LinkedIn mostrano senza tagliare. Le
   foto degli store sono verticali: senza ritaglio la scheda usciva a 1200×1800. */
const primoRamo = rami.find((r) => r.foto);
const fonteOg = image ?? immagine(primoRamo?.foto);
const og = fonteOg
  ? await getImage({ src: fonteOg, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 })
  : undefined;
const ogImage = og ? new URL(og.src, Astro.site).href : undefined;
const ogAlt = image ? (imageAlt ?? '') : (primoRamo?.fotoAlt ?? '');

/* Briciole di pane: homepage › sezione › pagina. Non sulla homepage né sulla
   404, dove non c'è un percorso da descrivere. */
const eHome = pathname === '/';
const e404 = pathname.startsWith('/404');
const genitori = briciole ?? [BRICIOLE_SEZIONE[pathname.split('/')[1]]].filter(Boolean);
const conBriciole = !eHome && !e404;
const vociBriciole: Briciola[] = [
  { nome: 'Home', url: '/' },
  ...genitori,
  { nome: nomeBreve ?? title, url: pathname },
];

const jsonLd = grafo([
  organizzazioneLd(),
  sitoLd(),
  paginaLd({
    url: canonical,
    nome: fullTitle,
    descrizione: description,
    tipo: tipoPagina,
    immagine: ogImage,
    conBriciole,
  }),
  ...(conBriciole ? [bricioleLd(canonical, vociBriciole)] : []),
  ...schema,
]);
---

<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Banner dei cookie, e Google Tag Manager solo dopo il consenso -->
    <Consenso />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={pubblicato ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {og && <meta property="og:image:width" content={String(og.attributes.width)} />}
    {og && <meta property="og:image:height" content={String(og.attributes.height)} />}
    {ogImage && ogAlt && <meta property="og:image:alt" content={ogAlt} />}
    {pubblicato && <meta property="article:published_time" content={pubblicato} />}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={jsonLd} />

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#contenuto">Salta al contenuto</a>

    <slot name="header" />

    <main id="contenuto">
      <slot />
    </main>

    <slot name="footer" />
  </body>
</html>
