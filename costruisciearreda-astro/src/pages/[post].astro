---
/**
 * Template degli articoli — 8 post, gli **unici** contenuti del sito che stanno
 * davvero in `post_content` di WordPress: tutto il resto è layout Elementor.
 *
 * Gli articoli hanno lo slug in radice (`/gres-costruisciearreda-consigli/`),
 * quindi questa rotta dinamica sta in radice. Le pagine one-off avranno file
 * statici propri (`src/pages/contatti.astro`, …) e in Astro una rotta statica
 * vince su una dinamica: non si pestano i piedi.
 *
 * Struttura misurata: titolo, autore e data, immagine di copertina, contenuto,
 * e una colonna laterale che nell'originale ha ricerca, categorie, tag e
 * condivisione. Ricerca e tag sono omessi: la prima richiede un indice lato
 * client che non è ancora deciso, i secondi nell'originale sono un titolo con
 * niente sotto.
 */
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/Hero.astro';
import Titoletto from '../components/Titoletto.astro';
import { immagine } from '../lib/immagini';
import { site } from '../data/site';
import { descrizioneDa, ID, testoDaHtml } from '../lib/seo';

export async function getStaticPaths() {
  const voci = await getCollection('posts');
  return voci.map((v) => ({ params: { post: v.data.slug }, props: { dati: v.data } }));
}

const { dati } = Astro.props;

const heroImg = immagine(dati.hero?.imagePath);
const copertina = immagine(dati.featuredImage?.path);
/* Quando la copertina specifica dell'articolo diventa anche la hero, non va
   ripetuta identica poche righe più sotto. */
const copertinaGiaInHero = dati.hero?.imagePath === dati.featuredImage?.path;

/* "admin" è il nome utente di WordPress, non un autore: stampato sotto il
   titolo ("di admin") e nei dati strutturati toglieva credibilità a ogni
   articolo. Gli articoli sono dell'azienda, e così si firmano. */
const autoreOriginale = dati.postInfo.AUTORE ?? null;
const autore = !autoreOriginale || autoreOriginale === 'admin' ? site.brand : autoreOriginale;

/* Il titolo dell'originale ha "Gres?Quando" senza spazio dopo il punto di
   domanda: si vede nel `<h1>` e nei risultati di ricerca. */
const titolo = dati.title.replace(/\?(?=\p{L})/gu, '? ');

/* Due `<title>` di Yoast da rifare: "Gres?Quando sceglierlo?" non contiene la
   parola che si cerca ("gres porcellanato"), e "Errori da evitare…" aveva perso
   il "5" del titolo vero. */
const titoliSeo: Record<string, string> = {
  'gres-costruisciearreda-consigli': 'Gres porcellanato: quando sceglierlo per casa',
  '5-errori-da-evitare-nella-scelta-dei-materiali-per-ledilizia':
    '5 errori da evitare nella scelta dei materiali edili',
};
const titoloSeo = titoliSeo[dati.slug] ?? dati.seoTitleCompleto ?? dati.seoTitle ?? titolo;
const dataIso = dati.postInfo.DATA_iso ?? null;
const dataTesto = dataIso
  ? new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', year: 'numeric' }).format(
      new Date(dataIso),
    )
  : (dati.postInfo.DATA ?? null);

const categoria = dati.postInfo.CATEGORIA ?? null;

const testo = testoDaHtml(dati.corpo[0]?.html);
const descrizione = dati.metaDescription ?? (testo ? descrizioneDa(testo) : site.description);

const urlAssoluto = new URL(Astro.url.pathname, Astro.site).href;

/* Google vuole un'immagine per mostrare l'articolo con l'anteprima. Stessi
   parametri dell'Open Graph in `BaseLayout`: Astro genera il file una volta sola. */
const immagineLd = copertina
  ? new URL(
      (await getImage({ src: copertina, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 })).src,
      Astro.site,
    ).href
  : undefined;

const articoloLd = {
  '@type': 'BlogPosting',
  '@id': `${urlAssoluto}#articolo`,
  headline: titolo,
  description: descrizione,
  ...(dataIso ? { datePublished: dataIso } : {}),
  ...(immagineLd ? { image: immagineLd } : {}),
  inLanguage: site.lang,
  author: { '@id': ID.organizzazione },
  publisher: { '@id': ID.organizzazione },
  mainEntityOfPage: { '@id': ID.pagina(urlAssoluto) },
  articleSection: categoria ?? 'Ultime news e articoli',
  wordCount: testo.split(' ').length,
};
const condividi = [
  { nome: 'LinkedIn', url: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(urlAssoluto)}` },
  { nome: 'Facebook', url: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(urlAssoluto)}` },
  { nome: 'WhatsApp', url: `https://wa.me/?text=${encodeURIComponent(`${titolo} ${urlAssoluto}`)}` },
];
---

<SiteLayout
  title={titoloSeo}
  description={descrizione}
  image={copertina}
  imageAlt={dati.featuredImage?.alt || titolo}
  nomeBreve={titolo}
  briciole={[{ nome: 'Ultime news e articoli', url: '/category/ultime-news-e-articoli/' }]}
  schema={[articoloLd]}
  pubblicato={dataIso ?? undefined}
>
  {
    heroImg && dati.hero && (
      <Hero
        as="p"
        title={dati.hero.title ?? ''}
        kicker={dati.hero.kicker ?? undefined}
        image={heroImg}
        imageAlt=""
      />
    )
  }

  <article class="container articolo">
    <header class="articolo__testa">
      <h1 class="articolo__titolo">{titolo}</h1>
      <p class="articolo__meta">
        {autore && <span>di {autore}</span>}
        {dataIso && <><span aria-hidden="true">·</span><time datetime={dataIso}>{dataTesto}</time></>}
        {!dataIso && dataTesto && <><span aria-hidden="true">·</span><span>{dataTesto}</span></>}
      </p>
    </header>

    {
      copertina && !copertinaGiaInHero && (
        <Image
          class="articolo__copertina"
          src={copertina}
          alt={dati.featuredImage?.alt || titolo}
          widths={[640, 960, 1280]}
          sizes="(min-width: 1025px) 62vw, 92vw"
          format="webp"
          quality={78}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      )
    }

    <div class="articolo__corpo">
      <div class="articolo__testo" set:html={dati.corpo[0]?.html ?? ''} />

      <aside class="articolo__lato">
        <section class="articolo__box">
          <Titoletto as="h2" size="label" tone="brand" rule={false}>categorie</Titoletto>
          <ul class="articolo__lista">
            <li>
              <a href="/category/ultime-news-e-articoli/">
                {categoria ?? 'Ultime news e articoli'}
              </a>
            </li>
          </ul>
        </section>

        <section class="articolo__box">
          <Titoletto as="h2" size="label" tone="brand" rule={false}>condividi</Titoletto>
          <ul class="articolo__lista">
            {
              condividi.map((c) => (
                <li>
                  <a href={c.url} target="_blank" rel="noopener noreferrer">{c.nome}</a>
                </li>
              ))
            }
          </ul>
        </section>
      </aside>
    </div>
  </article>
</SiteLayout>

<style>
  .articolo {
    padding-block: var(--section-y-lg) var(--section-y);
  }

  .articolo__testa {
    max-width: var(--container-text);
    margin-bottom: var(--s-10);
  }
  .articolo__titolo {
    margin: 0 0 var(--s-4);
    font-size: var(--t-display-sm);
    font-weight: var(--w-light);
    line-height: 1.15;
    text-transform: none;
    text-wrap: balance;
  }
  .articolo__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
    color: var(--c-ink-soft);
    font-size: var(--t-sm);
  }

  .articolo__copertina {
    width: 100%;
    margin-bottom: var(--s-12);
  }

  .articolo__corpo {
    display: grid;
    gap: var(--s-12);
    align-items: start;
  }
  @media (min-width: 1025px) {
    .articolo__corpo {
      grid-template-columns: minmax(0, 1fr) 15rem;
      gap: var(--s-20);
    }
  }

  .articolo__testo {
    max-width: var(--container-text);
  }
  .articolo__testo :global(h2),
  .articolo__testo :global(h3) {
    margin-top: var(--s-10);
    margin-bottom: var(--s-4);
    font-size: var(--t-xl);
    text-transform: none;
  }
  .articolo__testo :global(ul),
  .articolo__testo :global(ol) {
    padding-inline-start: var(--s-6);
  }

  .articolo__lato {
    display: grid;
    gap: var(--s-10);
  }
  .articolo__box {
    padding-top: var(--s-4);
    border-top: 1px solid var(--c-border);
  }
  .articolo__lista {
    display: grid;
    gap: var(--s-2);
    margin: var(--s-4) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--t-sm);
  }
  .articolo__lista li {
    margin: 0;
  }
  .articolo__lista a {
    color: var(--c-ink);
    text-decoration: none;
  }
  .articolo__lista a:hover {
    color: var(--c-brand);
  }
</style>
