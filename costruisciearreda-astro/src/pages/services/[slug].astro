---
/**
 * Template dei servizi — 8 pagine, struttura identica al 100% nell'originale.
 *
 * Struttura misurata: titolo del servizio, testo introduttivo, il marchio come
 * illustrazione, il corpo del testo. Nell'originale ci sono **due** copie del
 * corpo (una per desktop, una per mobile) e **due** immagini decorative diverse
 * per le due fasce: a 900px il testo si vede due volte. Qui una copia sola e
 * un'immagine sola (la seconda era uno screenshot della prima).
 *
 * L'`<h1>` è il nome del servizio. Nell'originale l'unico `<h1>` è il titolo
 * generico dell'hero — **identico su tutte e 8 le pagine** — mentre il nome del
 * servizio è un `<div>`. Deviazione dichiarata: SEO.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Hero from '../../components/Hero.astro';
import Titoletto from '../../components/Titoletto.astro';
import { immagine } from '../../lib/immagini';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const voci = await getCollection('services');
  return voci.map((v) => ({ params: { slug: v.data.slug }, props: { dati: v.data } }));
}

const { dati } = Astro.props;

const heroImg = immagine(dati.hero?.imagePath);
/** Il marchio usato come illustrazione: decorativo, quindi `alt` vuoto. */
const marchio = immagine('2024/06/LogoServizio.png');

/* La meta description manca su tutte e 8 le pagine nell'originale: in attesa dei
   testi definitivi si ricava dal primo paragrafo. Resta segnata come "da
   scrivere" nel report dell'estrazione. */
const primoTesto = dati.corpo[0]?.html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim() ?? '';
const descrizione =
  dati.metaDescription ?? (primoTesto ? primoTesto.slice(0, 155).trim() + '…' : site.description);
---

<SiteLayout
  title={dati.title}
  titleFull={dati.seoTitleCompleto ?? undefined}
  description={descrizione}
>
  {
    heroImg && dati.hero && (
      <Hero
        as="p"
        title={dati.hero.title ?? ''}
        kicker={dati.hero.kicker ?? undefined}
        image={heroImg}
        imageAlt=""
      />
    )
  }

  <div class="container servizio">
    <Titoletto as="h1" size="lg" tone="muted" class="servizio__titolo">{dati.title}</Titoletto>

    {dati.corpo[0] && <div class="servizio__intro" set:html={dati.corpo[0].html} />}

    <div class="servizio__corpo">
      {dati.corpo[1] && <div class="servizio__testo" set:html={dati.corpo[1].html} />}
      {
        marchio && (
          <Image
            class="servizio__marchio"
            src={marchio}
            alt=""
            widths={[420, 640, 860]}
            sizes="(min-width: 992px) 34vw, 26rem"
            format="webp"
            quality={80}
            loading="lazy"
            decoding="async"
          />
        )
      }
    </div>
  </div>
</SiteLayout>

<style>
  .servizio {
    padding-block: var(--section-y-lg) var(--section-y);
  }

  .servizio__titolo {
    margin-bottom: var(--s-12);
  }

  .servizio__intro {
    max-width: var(--container-text);
    margin-bottom: var(--s-15);
    font-size: var(--t-lg);
    line-height: var(--t-lg-lh);
  }

  .servizio__corpo {
    display: grid;
    gap: var(--s-12);
    align-items: start;
  }

  .servizio__marchio {
    width: min(100%, 26rem);
    margin-inline: auto;
  }

  @media (min-width: 992px) {
    .servizio__corpo {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
      gap: var(--s-20);
    }
    .servizio__marchio {
      width: 100%;
    }
  }
</style>
