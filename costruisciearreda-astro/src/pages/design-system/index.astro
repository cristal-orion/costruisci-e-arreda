---
/**
 * Pagina di controllo del design system. Non è una pagina del sito: serve a vedere
 * in un colpo d'occhio i token misurati e a confrontarli con il mirror.
 * `noindex` perché non deve finire in sitemap né nei motori.
 */
import BaseLayout from '../../layouts/SiteLayout.astro';
import Button from '../../components/Button.astro';
import Carousel from '../../components/Carousel.astro';
import Gallery from '../../components/Gallery.astro';
import Counter from '../../components/Counter.astro';
import Accordion from '../../components/Accordion.astro';
import Hero from '../../components/Hero.astro';
import Titoletto from '../../components/Titoletto.astro';

const colori = [
  ['--c-brand', '#C20E1A', 'Primario del brand. Usato sul testo di accento e su fondi pieni, mai sui bottoni.'],
  ['--c-brand-hover', '#9E0B15', 'Derivato: il mirror non espone uno stato hover misurabile.'],
  ['--c-ink', '#333333', 'Testo dominante: 32.213 caratteri sul campione, contro 3.301 di #7A7A7A.'],
  ['--c-ink-soft', '#7A7A7A', 'Testo secondario: didascalie, testi di servizio.'],
  ['--c-surface', '#FFFFFF', 'Fondo principale.'],
  ['--c-surface-alt', '#F5F5F5', 'Sezioni alternate e footer.'],
  ['--c-surface-dark', '#333333', 'Fondo scuro e submit dei form.'],
  ['--c-border', '#A6A6A6', 'Bordo tenue (.btn.greyBorder).'],
  ['--c-border-strong', '#333333', 'Bordo marcato.'],
];

const scala = [
  ['--t-xs', '12px', 'var(--t-xs)', 'var(--t-xs-lh)', 'Didascalie, footer minore'],
  ['--t-sm', '14px', 'var(--t-sm)', 'var(--t-sm-lh)', 'Testo di servizio, footer, form — la misura piu usata'],
  ['--t-md', '15px', 'var(--t-md)', 'var(--t-md-lh)', 'Estratti delle card news'],
  ['--t-base', '16px', 'var(--t-base)', 'var(--t-base-lh)', 'Paragrafi di contenuto'],
  ['--t-lg', '18px', 'var(--t-lg)', 'var(--t-lg-lh)', 'Paragrafi in evidenza'],
  ['--t-xl', '22px', 'var(--t-xl)', 'var(--t-xl-lh)', 'Titoli di card'],
  ['--t-2xl', '25px', 'var(--t-2xl)', 'var(--t-2xl-lh)', 'Titoli di blocco'],
  ['--t-3xl', '30px', 'var(--t-3xl)', 'var(--t-3xl-lh)', 'Titoli di sezione'],
  ['--t-counter', '80px', 'var(--t-counter)', '1', 'Numero del contatore — fisso, non fluido'],
];

const display = [
  ['--t-display-sm', '30 → 50px', 'var(--w-light)', 'H2 di sezione, maiuscolo'],
  ['--t-display', '30 → 60px', 'var(--w-extralight)', 'Titolo ampio, maiuscolo'],
  ['--t-display-lg', '40 → 70px', 'var(--w-regular)', 'Titolo maggiore, maiuscolo'],
  ['--hero-title-size', '30 → 80px', 'var(--w-light)', 'Titolo dentro il riquadro hero'],
];

const spazi = [
  ['--s-1', '4px'], ['--s-2', '8px'], ['--s-3', '12px'], ['--s-4', '16px'],
  ['--s-5', '20px'], ['--s-6', '24px'], ['--s-8', '32px'], ['--s-10', '40px'],
  ['--s-12', '48px'], ['--s-15', '60px'], ['--s-18', '72px'], ['--s-20', '80px'],
];

const pesi = [
  ['--w-extralight', 200], ['--w-light', 300], ['--w-regular', 400],
  ['--w-medium', 500], ['--w-semibold', 600], ['--w-bold', 700],
];

/**
 * Segnaposto per provare i componenti senza tirare dentro immagini vere:
 * un SVG inline con proporzioni variabili, così il masonry si vede davvero.
 */
const ph = (w: number, h: number, n: number) =>
  'data:image/svg+xml,' +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" width="${w}" height="${h}">` +
      `<rect width="100%" height="100%" fill="${n % 2 ? '#333' : '#c20e1a'}"/>` +
      `<text x="50%" y="50%" fill="#fff" font-family="sans-serif" font-size="${Math.round(w / 6)}"` +
      ` text-anchor="middle" dominant-baseline="middle">${w}×${h}</text></svg>`,
  );

/** Finta foto per l'hero: sfumatura, così si vede se la velatura funziona. */
const heroImg =
  'data:image/svg+xml,' +
  encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="900">' +
      '<defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1">' +
      '<stop offset="0" stop-color="#8a8f96"/><stop offset="0.55" stop-color="#d6d8db"/>' +
      '<stop offset="1" stop-color="#5c6169"/></linearGradient></defs>' +
      '<rect width="100%" height="100%" fill="url(#g)"/></svg>',
  );

const galleryItems = [
  [800, 1200], [800, 600], [800, 800], [800, 1000], [800, 500], [800, 1100],
  [800, 700], [800, 900],
].map(([w, h], i) => ({ src: ph(w, h, i), alt: `Immagine di prova ${i + 1}`, width: w, height: h }));

const carouselSlides = [[800, 600], [800, 600], [800, 600], [800, 600], [800, 600]].map(
  ([w, h], i) => ({ src: ph(w, h, i), alt: `Slide di prova ${i + 1}`, width: w, height: h }),
);

/** Valori misurati sull'originale (durata 2000ms, da 0). */
const contatori = [
  { value: 24, label: 'Anni di esperienza' },
  { value: 40, suffix: '+', label: 'Progetti Terminati' },
  { value: 100, label: 'Clienti soddisfatti' },
  { value: 10, label: 'obiettivi aziendali' },
];

/** Testi reali di /la-nostra-storia/, accorciati. */
const vociAccordion = [
  {
    title: 'Mission',
    html: '<p>La nostra missione è diventare <b>leader nel settore</b>, offrendo innovazione continua e nuove proposte di valore.</p>',
  },
  {
    title: 'Vision',
    html: '<p>Vogliamo essere riconosciuti come <b>leader del settore per innovazione e qualità</b>.</p>',
  },
  {
    title: 'Values',
    html: '<p><b>Meritocrazia:</b> il sacrificio e il duro lavoro portano ai risultati. <b>Ambizione:</b> sognare in grande. <b>Umiltà:</b> riconoscere i propri limiti.</p>',
  },
];
---

<BaseLayout
  title="Design system"
  description="Token di design misurati sul sito originale: colore, tipografia, spaziatura, bottoni e geometrie. Pagina di controllo interna."
  noindex
  bloccoContatti={false}
>
  <Hero
    as="h2"
    title={'Dalla progettazione\nalla realizzazione'}
    kicker="SERVIZI"
    image={heroImg}
    imageAlt=""
    imageWidth={1600}
    imageHeight={900}
  />

  <div class="container ds">
    <header class="ds__head">
      <p class="ds__kicker">Ricostruzione in Astro · fase A</p>
      <h1 class="ds__title">Design system</h1>
      <p class="ds__lede">
        Ogni valore di questa pagina è <strong>misurato</strong> sul sito originale
        con <code>getComputedStyle</code> su 16 pagine e 3 viewport, non dedotto
        leggendo il CSS di Elementor. Le fonti sono{' '}
        <code>_migrazione/baseline/tokens-mirror.json</code> e{' '}
        <code>_migrazione/baseline/layout-mirror.json</code>, rigenerabili
        con <code>harvest-tokens.js</code> e <code>harvest-layout.js</code>.
      </p>
    </header>

    <!-- ---------------------------------------------------------------- colore -->
    <section class="ds__block">
      <h2 class="ds__h2">Colore</h2>
      <ul class="ds__swatches">
        {colori.map(([token, hex, nota]) => (
          <li class="sw">
            <span class="sw__chip" style={`background:${hex}`}></span>
            <code class="sw__token">{token}</code>
            <span class="sw__hex">{hex}</span>
            <span class="sw__note">{nota}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- ----------------------------------------------------------- tipografia -->
    <section class="ds__block">
      <h2 class="ds__h2">Tipografia</h2>
      <p class="ds__note">
        Un solo font: <strong>Montserrat variable</strong> (asse 100–900, latino, 40 KB).
        Il sito originale caricava 90 <code>@font-face</code> statici di Montserrat più Roboto
        e Roboto Slab. Roboto Slab non veniva mai reso; Roboto sì, ma solo perché{' '}
        <code>.elementor-widget-text-editor</code> lo forza su 34 pagine — un default di
        Elementor che trapela. Qui è unificato su Montserrat.
      </p>

      <div class="scroll-x">
      <table class="ds__table">
        <thead><tr><th>Token</th><th>Misura</th><th>Interlinea</th><th>Uso</th><th>Resa</th></tr></thead>
        <tbody>
          {scala.map(([token, px, size, lh, uso]) => (
            <tr>
              <td><code>{token}</code></td>
              <td>{px}</td>
              <td>{lh}</td>
              <td>{uso}</td>
              <td style={`font-size:${size};line-height:${lh}`}>Edilizia, design e ferramenta</td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>

      <h3 class="ds__h3">Display (fluidi)</h3>
      {display.map(([token, range, peso, uso]) => (
        <div class="ds__display">
          <p class="ds__displayMeta"><code>{token}</code> · {range} · peso {peso.replace('var(--w-', '').replace(')', '')} · {uso}</p>
          <p class="ds__displaySample" style={`font-size:var(${token});font-weight:${peso}`}>
            Costruisci e Arreda
          </p>
        </div>
      ))}

      <h3 class="ds__h3">Pesi</h3>
      <ul class="ds__weights">
        {pesi.map(([token, n]) => (
          <li style={`font-weight:${n}`}>{n} · <code>{token}</code> · Edilizia, design e ferramenta</li>
        ))}
      </ul>
    </section>

    <!-- --------------------------------------------------------------- bottoni -->
    <section class="ds__block">
      <h2 class="ds__h2">Bottoni</h2>
      <p class="ds__note">
        Sei varianti nel sito originale, ridotte a cinque. Nessuna usava il rosso del brand:
        l'azione primaria è il grigio scuro pieno dei submit dei form. Raggio zero.
      </p>
      <div class="ds__btnRow">
        <Button variant="solid">Invia richiesta</Button>
        <Button variant="outline-dark">Scopri di più</Button>
        <Button variant="outline-muted">Scopri di più</Button>
        <Button variant="text">Scopri di più</Button>
      </div>
      <div class="ds__btnRow ds__btnRow--dark">
        <Button variant="outline-light">Scopri di più</Button>
      </div>
      <div class="ds__btnRow">
        <Button variant="outline-dark" size="sm">Scopri il servizio</Button>
        <Button variant="solid" size="sm">Invia</Button>
      </div>
    </section>

    <!-- ----------------------------------------------------------- spaziatura -->
    <section class="ds__block">
      <h2 class="ds__h2">Spaziatura</h2>
      <p class="ds__note">
        Un solo sistema, base 4px. Il sito originale mescolava 10/12/20/42/50/72/80/100/150px
        su quattro contesti annidati: è la causa del bug dell'hero corretto dalle patch 001/002.
      </p>
      <ul class="ds__spaces">
        {spazi.map(([token, px]) => (
          <li><span class="ds__bar" style={`width:var(${token})`}></span><code>{token}</code> <span>{px}</span></li>
        ))}
      </ul>
      <p class="ds__note">
        Ritmo verticale delle sezioni: <code>--section-y</code> 60 → 100px,
        e <code>--section-y-lg</code> 80 → 150px (misurati 100px e 150px a 1440px).
      </p>
    </section>

    <!-- -------------------------------------------------------- componenti -->
    <section class="ds__block">
      <h2 class="ds__h2">Componenti</h2>
      <p class="ds__note">
        I quattro componenti con logica reale del sito. Le configurazioni vengono
        dai <code>data-settings</code> di Elementor e dalla misura nel browser, non da come
        sembrano a occhio. Nessuna libreria: al posto di Swiper (140 KB), slick (42 KB),
        isotope (35 KB) e del lightbox di Elementor ci sono in tutto poche righe di JS,
        e ogni componente resta usabile anche se il JS non parte.
      </p>

      <h3 class="ds__h3">Carousel</h3>
      <p class="ds__note">
        Autoplay 5s, infinito, transizione 500ms, pausa su hover e su interazione,
        navigazione a punti e nessuna freccia — la configurazione unica delle 23 istanze
        dell'originale. Misurato: 1 slide per vista a 390px, 2 a 900px. Qui è una striscia
        con <code>scroll-snap</code>: senza JavaScript scorre comunque col dito e con la tastiera.
      </p>
      <Carousel label="Esempio di carousel" perView={{ base: 1, tablet: 2, desktop: 3 }} gap="10px">
        {carouselSlides.map((s) => (
          <figure style="margin:0"><img src={s.src} alt={s.alt} width={s.width} height={s.height} /></figure>
        ))}
      </Carousel>

      <h3 class="ds__h3">Gallery e lightbox</h3>
      <p class="ds__note">
        Masonry a 3 colonne su desktop, 2 su tablet e mobile, 10px di spazio, lightbox
        sull'immagine piena — come nei <code>data-settings</code>. Il masonry è il
        multi-colonna CSS, quindi zero libreria di posizionamento. Il lightbox è
        un <code>&lt;dialog&gt;</code> nativo: cattura del focus, Esc e sfondo li dà il browser.
        Senza JavaScript ogni voce resta un link all'immagine piena.
      </p>
      <Gallery items={galleryItems} label="Esempio di galleria" columns={{ base: 2, tablet: 2, desktop: 3 }} />

      <h3 class="ds__h3">Contatore</h3>
      <p class="ds__note">
        Valori e durata dell'originale. Differenza voluta: qui il numero finale sta{' '}
        <strong>nell'HTML</strong> e l'animazione parte da zero. Nell'originale il valore
        vive solo nel JavaScript, quindi senza scorrere la pagina il contatore mostra{' '}
        <code>0</code> — misurato — e se il JS non parte resta zero.
      </p>
      <div class="grid grid--4">
        {contatori.map((c) => <Counter value={c.value} suffix={c.suffix} label={c.label} />)}
      </div>

      <h3 class="ds__h3">Accordion</h3>
      <p class="ds__note">
        Tre voci, la prima aperta, titolo <code>&lt;h2&gt;</code> — come misurato su{' '}
        <code>/la-nostra-storia/</code>. Fatto con <code>&lt;details&gt;</code> nativi:
        zero JavaScript, e l'attributo <code>name</code> condiviso rende le voci
        mutuamente esclusive senza scrivere una riga.
      </p>
      <Accordion items={vociAccordion} />
    </section>

    <!-- ---------------------------------------------------- hero e titoletto -->
    <section class="ds__block">
      <h2 class="ds__h2">Hero</h2>
      <p class="ds__note">
        È il riquadro in testa a questa pagina. Riquadro di 750px su desktop e tablet,
        400px su mobile; titolo <code>clamp(30px, 5.4vw, 80px)</code> peso 300 maiuscolo;
        blocco di testo a 100px dal fondo. Il rientro dal bordo è
        <strong>un solo valore</strong>, <code>--hero-inset</code>, sommato al gutter del
        contenitore: 114px a 1440px e 32px a 390px, gli stessi numeri misurati
        sull'originale. Nessun <code>left</code> negativo in percentuale — era la causa
        del titolo tranciato fra 769px e 1450px (patch 001/002).
      </p>
      <p class="ds__note">
        Due differenze volute: l'immagine è un <code>&lt;img&gt;</code> e non una
        <code>background-image</code> inline (così prende <code>srcset</code> e
        <code>fetchpriority</code>, essendo l'elemento LCP), e c'è una velatura in basso
        perché il testo bianco su una foto qualsiasi non garantisce contrasto.
        La velatura si disattiva con <code>scrim={false}</code>.
      </p>

      <h3 class="ds__h3">Titoletto</h3>
      <p class="ds__note">
        Il segno grafico ricorrente: una riga da 1px sotto il titolo, che sfonda fino al
        bordo sinistro della finestra e si ferma dove finisce il testo. Nell'originale la
        classe si chiama <code>.titolettoBorder</code> ma non ha alcun bordo: misurando,
        la riga è uno <code>::after</code> con <code>width: 400%; left: -300%</code> —
        lo stesso trucco che ha causato il bug dell'hero. Qui è calcolata dal riquadro
        verso il bordo, senza percentuali negative.
      </p>
      <div class="ds__titoletti">
        <Titoletto as="p" size="label" tone="brand">SERVIZI</Titoletto>
        <Titoletto as="p" size="sm" tone="dark">Le nostre realizzazioni</Titoletto>
        <Titoletto as="p" size="md" tone="muted">I nostri servizi</Titoletto>
        <Titoletto as="p" size="lg" tone="dark">News and Events</Titoletto>
      </div>
    </section>

    <!-- ---------------------------------------------------------- geometrie -->
    <section class="ds__block">
      <h2 class="ds__h2">Geometrie misurate</h2>
      <div class="scroll-x">
      <table class="ds__table">
        <tbody>
          <tr><td><code>--header-h</code></td><td>101px desktop · 69px mobile</td><td>Costante su tutte le 67 pagine</td></tr>
          <tr><td><code>--hero-h</code></td><td>750px desktop e tablet · 400px mobile</td><td>Riquadro immagine dell'hero</td></tr>
          <tr><td><code>--hero-inset</code></td><td>42px da 769px in su · 12px sotto</td><td>Rientro dentro il contenitore: sommato al margine dà 114px a 1440px e 32px a 390px, gli stessi dell'originale</td></tr>
          <tr><td><code>--container</code></td><td>1296px</td><td>Larghezza di contenuto misurata a 1440px (contenitore del tema 1320 meno 12px di padding per lato)</td></tr>
          <tr><td><code>--container-narrow</code></td><td>1116px</td><td>L'equivalente per il contenitore di Elementor (1140)</td></tr>
          <tr><td><code>--gutter</code></td><td><code>clamp(20px, 5vw, 72px)</code></td><td>Margine laterale, proporzionale: Bootstrap lo faceva saltare fra 32px e 102px a denti di sega</td></tr>
          <tr><td><code>--radius-sm</code></td><td>3px</td><td>Unico raggio ricorrente</td></tr>
          <tr><td><code>--radius-notch</code></td><td>0 30px 0 0</td><td>Motivo distintivo su card e immagini</td></tr>
        </tbody>
      </table>
      </div>
      <div class="ds__notchRow">
        <div class="ds__notch">radius-notch</div>
        <div class="ds__notch ds__notch--alt">su fondo alternato</div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .ds { padding-block: var(--s-12) var(--s-20); }
  .ds__head { max-width: 68ch; margin-bottom: var(--s-20); }
  .ds__kicker {
    margin-bottom: var(--s-2);
    color: var(--c-brand);
    font-size: var(--t-sm);
    font-weight: var(--w-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .ds__title { margin-bottom: var(--s-5); font-size: var(--t-display-sm); }
  .ds__lede { font-size: var(--t-lg); line-height: var(--t-lg-lh); color: var(--c-ink-soft); }

  .ds__block { padding-top: var(--s-12); border-top: 1px solid var(--c-border); }
  .ds__block + .ds__block { margin-top: var(--s-20); }
  .ds__h2 {
    margin-bottom: var(--s-6);
    font-size: var(--t-3xl);
    font-weight: var(--w-bold);
    text-transform: none;
  }
  .ds__h3 { margin: var(--s-12) 0 var(--s-5); font-size: var(--t-xl); }
  .ds__note { max-width: 78ch; margin-bottom: var(--s-8); color: var(--c-ink-soft); }

  code { font-size: 0.9em; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }

  /* swatch */
  .ds__swatches { display: grid; gap: var(--s-4); margin: 0; padding: 0; list-style: none; }
  .sw {
    display: grid;
    grid-template-columns: 3.5rem 12rem 5rem 1fr;
    gap: var(--s-4);
    align-items: center;
    margin: 0;
    font-size: var(--t-sm);
  }
  .sw__chip { height: 2.5rem; border: 1px solid var(--c-border); }
  .sw__hex { color: var(--c-ink-soft); }
  .sw__note { color: var(--c-ink-soft); }
  @media (max-width: 768px) {
    .sw { grid-template-columns: 2.5rem 1fr; }
    .sw__note { grid-column: 1 / -1; }
  }

  /* tabelle */
  .ds__table { font-size: var(--t-sm); }
  .ds__table th,
  .ds__table td {
    padding: var(--s-3) var(--s-4) var(--s-3) 0;
    text-align: left;
    vertical-align: baseline;
    border-bottom: 1px solid var(--c-border);
  }
  .ds__table th { font-weight: var(--w-semibold); text-transform: uppercase; font-size: var(--t-xs); letter-spacing: 0.06em; }

  /* display */
  .ds__display { margin-bottom: var(--s-8); }
  .ds__displayMeta { margin-bottom: var(--s-2); font-size: var(--t-xs); color: var(--c-ink-soft); }
  .ds__displaySample { margin: 0; text-transform: uppercase; line-height: 1; }

  .ds__weights { margin: 0; padding: 0; list-style: none; }
  .ds__weights li { margin: 0 0 var(--s-3); font-size: var(--t-lg); }

  /* bottoni */
  .ds__btnRow { display: flex; flex-wrap: wrap; gap: var(--s-4); align-items: center; margin-bottom: var(--s-5); }
  .ds__btnRow--dark { padding: var(--s-6); background: var(--c-surface-dark); }

  /* spazi */
  .ds__spaces { margin: 0 0 var(--s-8); padding: 0; list-style: none; font-size: var(--t-sm); }
  .ds__spaces li { display: flex; gap: var(--s-4); align-items: center; margin: 0 0 var(--s-2); }
  .ds__spaces span:last-child { color: var(--c-ink-soft); }
  .ds__bar { height: 1rem; background: var(--c-brand); flex: none; }

  .ds__titoletti {
    display: grid;
    gap: var(--s-15);
    margin-top: var(--s-12);
  }

  /* notch */
  .ds__notchRow { display: flex; flex-wrap: wrap; gap: var(--s-6); margin-top: var(--s-8); }
  .ds__notch {
    display: grid;
    place-items: center;
    width: 14rem;
    height: 8rem;
    color: var(--c-white);
    font-size: var(--t-sm);
    background: var(--c-surface-dark);
    border-radius: var(--radius-notch);
  }
  .ds__notch--alt { color: var(--c-ink); background: var(--c-surface-alt); }
</style>
