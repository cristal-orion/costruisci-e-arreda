---
/**
 * Footer — misurato: fondo `#F5F5F5`, titoli di colonna `<h3>` 16px peso 700
 * maiuscolo nel rosso del brand, link 14px peso 400 `#333`.
 *
 * Contenuto trascritto dal footer del mirror: logo, i tre social, quattro colonne
 * di link, le sedi raggruppate per tipo, il blocco newsletter e la riga legale.
 *
 * Tre cose da sapere:
 *  - **Telefono ed email non stanno nel footer** dell'originale (era annotato di
 *    sì): stanno nel blocco "Realizza con noi il tuo progetto" sopra il footer.
 *  - Il link "Company profile" dell'originale punta a `#`: è morto, ed è omesso.
 *  - Il form newsletter dell'originale è il **CF7 467** (non il 95: quello è il
 *    form del blocco contatti nel corpo pagina). Va rifatto: arriva al passo
 *    "Form" del piano, insieme agli altri cinque.
 */
import logo from '../assets/logo.svg';
import Form from './Form.astro';
import { colonneFooter, legalFooter } from '../data/menu';
import { company, sediPerTipo, site, social } from '../data/site';

/* L'originale stampa "© 2024" fisso. Qui l'anno è quello corrente: un anno
   fermo è semplicemente sbagliato, e ricordarsi di aggiornarlo a mano non è
   un piano. Deviazione dichiarata. */
const anno = new Date().getFullYear();

/**
 * Icone social come SVG in linea: l'originale usava Font Awesome brands, cioè
 * un'intera icon font (una delle tre sovrapposte) per tre glifi.
 * Tracciati dei marchi presi da Simple Icons (CC0), viewBox 24×24.
 */
const iconeSocial: Record<string, string> = {
  LinkedIn:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  Facebook:
    'M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z',
  Instagram:
    'M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913a5.885 5.885 0 0 0 1.384 2.126A5.868 5.868 0 0 0 4.14 23.37c.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558a5.898 5.898 0 0 0 2.126-1.384 5.86 5.86 0 0 0 1.384-2.126c.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913a5.89 5.89 0 0 0-1.384-2.126A5.847 5.847 0 0 0 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.9.419.418.68.816.9 1.38.16.422.36 1.057.41 2.227.055 1.265.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227a3.81 3.81 0 0 1-.899 1.382 3.744 3.744 0 0 1-1.38.9c-.42.16-1.065.36-2.235.41-1.274.055-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421a3.716 3.716 0 0 1-1.379-.899 3.644 3.644 0 0 1-.9-1.38c-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 1 0 0-12.324zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405a1.441 1.441 0 0 1-2.88 0 1.44 1.44 0 0 1 2.88 0z',
};
---

<footer class="footer">
  <div class="container footer__top">
    <div class="footer__brand">
      <a href="/" aria-label={`${site.shortName} — vai alla homepage`}>
        <img src={logo.src} width={logo.width} height={logo.height} alt="" />
      </a>

      <ul class="footer__social">
        {
          social.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.nome}>
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                  <path d={iconeSocial[s.nome]} fill="currentColor" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer__cols">
      {
        colonneFooter.map((col) => (
          <nav class="footer__col" aria-labelledby={`footer-${col.titolo.replace(/\s+/g, '-')}`}>
            <h3 class="footer__titolo" id={`footer-${col.titolo.replace(/\s+/g, '-')}`}>
              {col.titolo}
            </h3>
            <ul class="footer__lista">
              {col.voci.map((v) => (
                <li>
                  <a href={v.href ?? '#'}>{v.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      {
        sediPerTipo.map((gruppo) => (
          <div class="footer__col">
            <h3 class="footer__titolo">{gruppo.tipo}</h3>
            <ul class="footer__sedi">
              {gruppo.sedi.map((s) => (
                <li>
                  {s.righe[0]}
                  <br />
                  {s.righe[1]}
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="footer__col footer__col--newsletter">
        <h3 class="footer__titolo">Iscriviti alla newsletter</h3>
        <p class="footer__testo">
          Registrati alla nostra Newsletter per restare sempre aggiornato su tutte le
          novità di Costruisci e Arreda.
        </p>
        <Form form="newsletter" titolo="Iscrizione alla newsletter" class="footer__form" />
      </div>
    </div>
  </div>

  <div class="footer__legal">
    <div class="container footer__legalRow">
      <p class="footer__legalTesto">
        © {anno} {company.legalName} – P.IVA:{company.vat}
        {
          legalFooter.map((v) => (
            <>
              {' | '}
              <a href={v.href ?? '#'}>{v.label}</a>
            </>
          ))
        }
      </p>
      <p class="footer__legalTesto">
        Credits: <a href="http://www.vibgroup.it" target="_blank" rel="noopener noreferrer">{company.credits}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--c-surface-alt);
  }

  .footer__top {
    padding-block: var(--section-y) var(--s-12);
  }

  .footer__brand {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-6);
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--s-12);
  }
  .footer__brand img {
    width: auto;
    height: 56px;
  }

  .footer__social {
    display: flex;
    gap: var(--s-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer__social li {
    margin: 0;
  }
  .footer__social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    color: var(--c-ink);
    border: 1px solid var(--c-border);
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .footer__social a:hover {
    color: var(--c-brand);
    border-color: var(--c-brand);
  }

  .footer__cols {
    display: grid;
    gap: var(--s-10) var(--s-8);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }

  .footer__titolo {
    margin: 0 0 var(--s-4);
    color: var(--c-brand);
    font-size: var(--t-base);
    font-weight: var(--w-bold);
    line-height: 1.3;
    text-transform: uppercase;
  }

  .footer__lista,
  .footer__sedi {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--t-sm);
    line-height: var(--t-sm-lh);
  }
  .footer__lista li,
  .footer__sedi li {
    margin: 0;
  }
  .footer__lista a {
    color: var(--c-ink);
    text-decoration: none;
  }
  .footer__lista a:hover {
    color: var(--c-brand);
  }
  .footer__sedi {
    gap: var(--s-4);
    color: var(--c-ink);
  }

  .footer__col--newsletter {
    grid-column: span 2;
  }
  @media (max-width: 768px) {
    .footer__col--newsletter {
      grid-column: auto;
    }
  }
  .footer__testo {
    margin: 0;
    font-size: var(--t-sm);
    line-height: var(--t-sm-lh);
  }

  .footer__legal {
    border-top: 1px solid var(--c-border);
  }
  .footer__legalRow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
    align-items: baseline;
    justify-content: space-between;
    padding-block: var(--s-5);
  }
  .footer__legalTesto {
    margin: 0;
    color: var(--c-ink);
    font-size: var(--t-xs);
    line-height: var(--t-xs-lh);
  }
  .footer__legalTesto a {
    color: var(--c-ink);
    text-decoration: underline;
  }
  .footer__legalTesto a:hover {
    color: var(--c-brand);
  }
</style>
