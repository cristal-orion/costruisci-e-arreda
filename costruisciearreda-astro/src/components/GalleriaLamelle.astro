---
/**
 * Galleria a lamelle — la galleria di Home Design (**voce B15**).
 *
 * Le foto stanno in piedi, una accanto all'altra, come i listelli di legno
 * della parete dello store e come le campate dell'hero: strisce verticali
 * separate da fughe di 1px. Una sola è aperta, le altre sono lamelle
 * strette, scurite e senza colore, con il nome scritto in verticale come sul
 * dorso di un libro. Puntarne una (o raggiungerla con la tastiera, o toccarla)
 * la apre e ridà il colore; un clic sulla lamella aperta ingrandisce la foto.
 *
 * Perché non la `Gallery` a masonry: era una griglia di miniature come ce ne
 * sono su ogni sito. Qui la foto non si guarda tutta insieme, si scopre una
 * per volta — che per una sezione di oggetti scelti, uno per uno, è il modo
 * giusto di guardarla.
 *
 * **Come funziona, senza una riga di libreria:**
 *  - le lamelle sono un `flex` e quella aperta ha `flex-grow: 6` contro 1: la
 *    transizione è del solo `flex-grow`, che il browser sa animare;
 *  - la foto ha **larghezza fissa**, pari a quella della lamella aperta
 *    (`cqw`: unità del contenitore), e sta centrata: aprendo la lamella la
 *    foto non si ingrandisce, **si scopre**. Con `object-fit: cover` su una
 *    larghezza che cambia, la foto cambiava scala a ogni frame;
 *  - da 992px è la parete; sotto è una fila da scorrere con `scroll-snap`,
 *    con la didascalia sempre visibile. Sul tablet in orizzontale il primo
 *    tocco apre la lamella e il secondo ingrandisce.
 *
 * **Senza JavaScript** ogni lamella resta un link alla foto grande (la prima
 * è aperta), come nella `Gallery`. Con `prefers-reduced-motion` non c'è
 * nessuna transizione: i token `--dur*` vanno a 0.
 *
 * Accessibilità: ogni lamella è un link con il proprio nome; le frecce
 * sinistra/destra spostano il fuoco da una all'altra; il lightbox è un
 * `<dialog>`, che cattura il focus e si chiude con Esc.
 *
 * Il lightbox è una copia ridotta di quello di `Gallery.astro`: è rifatto qui
 * per non toccare gli store e le realizzazioni, che lo usano. Se un giorno
 * serve in un terzo posto, va estratto in un componente solo.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item {
  src: ImageMetadata;
  /** Descrizione della foto, per chi non la vede. */
  alt: string;
  /** Il nome breve dell'oggetto: sta sulla lamella e nel lightbox. */
  nome: string;
  /** `object-position` della foto: dove sta il soggetto, in verticale. */
  fuoco?: string;
}

interface Props {
  items: Item[];
  /** Nome della regione, obbligatorio: la galleria è un gruppo navigabile. */
  label: string;
  class?: string;
}

const { items, label, class: extraClass }: Props = Astro.props;

/* Per il lightbox serve una versione grande ma ragionevole: l'originale a
   piena risoluzione sarebbe di diversi megabyte. */
const voci = await Promise.all(
  items.map(async (it, i) => ({
    ...it,
    numero: String(i + 1).padStart(2, '0'),
    grande: (
      await getImage({ src: it.src, width: Math.min(1920, it.src.width), format: 'webp', quality: 78 })
    ).src,
  })),
);
---

<section class:list={['lamelle', extraClass]} data-lamelle aria-label={label} style={`--n:${voci.length}`}>
  <p class="lamelle__guida">
    <span class="lamelle__guidaMouse">Passa sopra una foto per aprirla, clicca per ingrandirla.</span>
    <span class="lamelle__guidaTocco">Scorri di lato, tocca una foto per ingrandirla.</span>
  </p>

  <ol class="lamelle__fila">
    {
      voci.map((it, i) => (
        <li class="lamelle__lamella" style={`--i:${i}`} data-attiva={i === 0 ? '' : undefined}>
          <a
            class="lamelle__link"
            href={it.grande}
            data-lamella
            aria-label={`Ingrandisci: ${it.alt}`}
            aria-current={i === 0 ? 'true' : undefined}
          >
            <Image
              class="lamelle__img"
              src={it.src}
              alt={it.alt}
              widths={[400, 600, 800, 1000]}
              sizes="(min-width: 992px) 40vw, 78vw"
              format="webp"
              quality={76}
              loading="lazy"
              decoding="async"
              style={it.fuoco ? `object-position: ${it.fuoco}` : undefined}
            />
            <span class="lamelle__numero" aria-hidden="true">{it.numero}</span>
            <span class="lamelle__spina" aria-hidden="true">{it.nome}</span>
            <span class="lamelle__didascalia" aria-hidden="true">
              <span class="lamelle__nome">{it.nome}</span>
              <span class="lamelle__azione">Ingrandisci</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>

  <dialog class="lightbox" aria-label="Immagine ingrandita">
    <figure class="lightbox__figure">
      <img class="lightbox__img" alt="" />
      <figcaption class="lightbox__caption"></figcaption>
    </figure>
    <button class="lightbox__btn lightbox__btn--prev" type="button" aria-label="Immagine precedente">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 5l-7 7 7 7"></path></svg>
    </button>
    <button class="lightbox__btn lightbox__btn--next" type="button" aria-label="Immagine successiva">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5l7 7-7 7"></path></svg>
    </button>
    <button class="lightbox__btn lightbox__btn--close" type="button" aria-label="Chiudi">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
  </dialog>
</section>

<style>
  .lamelle {
    /* quante parti di spazio prende la lamella aperta, contro 1 per le altre */
    --lam-attiva: 6;
    --lam-altezza: clamp(30rem, 46vw, 40rem);
    width: 100%;
  }

  .lamelle__guida {
    margin: 0 0 var(--s-6);
    /* eredita il colore della sezione: bianco su fondo scuro, scuro su chiaro */
    color: inherit;
    font-size: var(--t-xs);
    line-height: var(--t-xs-lh);
    letter-spacing: 0.04em;
    opacity: 0.72;
  }
  /* "passa sopra" ha senso solo dove c'è un mouse e la parete è una parete */
  .lamelle__guidaMouse {
    display: none;
  }

  /* ---------------------------------------------------------------- fila
     Il fondo è una fila da scorrere: è lo stato di partenza, quello del
     telefono. La parete è la variante da 992px.                              */
  .lamelle__fila {
    display: flex;
    gap: var(--s-3);
    margin: 0;
    padding: 0 var(--gutter) var(--s-4);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    list-style: none;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
  }
  .lamelle__guida {
    padding-inline: var(--gutter);
  }

  .lamelle__lamella {
    position: relative;
    /* `base.css` dà un margine sopra ogni `<li>` dal secondo in poi: su una fila
       di lamelle voleva dire 8px di fondo in vista sopra tutte tranne la prima */
    margin: 0;
    flex: 0 0 min(78vw, 20rem);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--c-ink);
    scroll-snap-align: start;
  }

  .lamelle__link {
    position: absolute;
    inset: 0;
    display: block;
    color: var(--c-white);
    text-decoration: none;
  }
  /* Il fuoco globale è rosso su 2px, e su una foto scura non si vede. */
  .lamelle__link:focus-visible {
    outline: 2px solid var(--c-white);
    outline-offset: -5px;
  }

  .lamelle__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Velo in basso, dove sta il nome: lo stesso gesto della parete in homepage.
     E uno più leggero in alto, per il numero: sulle foto chiare (la sedia
     contro il muro bianco) il bianco del numero spariva. */
  .lamelle__link::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(0 0 0 / 82%) 0%, rgb(0 0 0 / 0%) 62%),
      linear-gradient(to bottom, rgb(0 0 0 / 48%) 0%, rgb(0 0 0 / 0%) 26%);
    pointer-events: none;
  }

  .lamelle__numero,
  .lamelle__spina,
  .lamelle__didascalia {
    position: absolute;
    z-index: 1;
    text-shadow: 0 1px 3px rgb(0 0 0 / 55%);
  }

  /* Il numero ha una sua etichetta scura: sulle foto chiare (la sedia contro il
     muro bianco) nessun velo ragionevole basta a tenere 4,5 a 1 sul bianco —
     misurato, 2,2 a 1 anche con il velo in alto. Sul fondo scuro dell'etichetta
     il contrasto non dipende più dalla foto. */
  .lamelle__numero {
    top: var(--s-4);
    left: var(--s-4);
    padding: 2px 7px;
    background: rgb(0 0 0 / 74%);
    font-size: var(--t-xs);
    font-weight: var(--w-medium);
    letter-spacing: 0.08em;
    text-shadow: none;
  }

  .lamelle__spina {
    display: none;
  }

  .lamelle__didascalia {
    bottom: var(--s-5);
    left: var(--s-5);
    display: grid;
    gap: var(--s-3);
    width: max-content;
    max-width: calc(100% - 2 * var(--s-5));
  }
  .lamelle__nome {
    padding-bottom: var(--s-3);
    border-bottom: 1px solid rgb(255 255 255 / 40%);
    font-size: clamp(1.125rem, 1.5vw, 1.5rem);
    font-weight: var(--w-light);
    line-height: 1.1;
    text-transform: uppercase;
  }
  .lamelle__azione {
    display: flex;
    gap: var(--s-2);
    align-items: center;
    font-size: var(--t-xs);
    color: rgb(255 255 255 / 88%);
  }
  .lamelle__azione::before {
    content: '';
    width: 14px;
    height: 1px;
    background: var(--c-brand);
  }

  /* ---------------------------------------------------------------- parete */
  @media (min-width: 992px) {
    .lamelle {
      width: min(100% - 2 * var(--gutter), var(--container));
      margin-inline: auto;
    }
    .lamelle__guida {
      padding-inline: 0;
    }
    .lamelle__guidaTocco {
      display: none;
    }
    .lamelle__guidaMouse {
      display: inline;
    }
    /* senza mouse (un tablet in orizzontale) il primo tocco apre, il secondo
       ingrandisce: il testo "passa sopra" sarebbe una bugia */
    @media (hover: none) {
      .lamelle__guidaMouse {
        display: none;
      }
      .lamelle__guidaTocco {
        display: inline;
      }
    }

    .lamelle__fila {
      gap: 1px;
      height: var(--lam-altezza);
      padding: 0;
      overflow: hidden;
      /* le fughe: il fondo passa fra le lamelle perché il `gap` lo lascia
         vedere, come nella parete dell'hero */
      background: rgb(255 255 255 / 22%);
      /* la larghezza della lamella aperta si calcola da questa, in `cqw` */
      container-type: inline-size;
      scroll-snap-type: none;
    }

    .lamelle__lamella {
      flex: 1 1 0;
      min-width: 0;
      aspect-ratio: auto;
      transition: flex-grow calc(var(--dur-slow) * 1.5) var(--ease);
    }
    .lamelle__lamella[data-attiva] {
      flex-grow: var(--lam-attiva);
    }

    /* La foto ha la larghezza della lamella **aperta** e sta centrata: la
       lamella aperta la mostra intera, quelle chiuse ne mostrano la fascia
       centrale, e aprirsi è uno scoprire, non uno zoom. */
    .lamelle__img {
      inset: auto;
      top: 0;
      left: 50%;
      width: calc(100cqw * var(--lam-attiva) / (var(--n) - 1 + var(--lam-attiva)));
      max-width: none;
      transform: translateX(-50%) scale(1.06);
      filter: grayscale(0.85) brightness(0.72);
      transition:
        filter calc(var(--dur-slow) * 1.5) var(--ease),
        transform calc(var(--dur-slow) * 2.5) var(--ease);
    }
    .lamelle__lamella[data-attiva] .lamelle__img {
      transform: translateX(-50%);
      filter: none;
    }
    .lamelle__lamella[data-attiva] .lamelle__link {
      cursor: zoom-in;
    }

    /* Il nome sulla lamella chiusa: verticale, come sul dorso di un libro. */
    .lamelle__spina {
      bottom: var(--s-6);
      left: 50%;
      display: block;
      font-size: var(--t-xs);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      white-space: nowrap;
      writing-mode: vertical-rl;
      transform: translateX(-50%) rotate(180deg);
      /* riappare a lamella chiusa, non mentre si chiude: altrimenti per un
         attimo il nome orizzontale e quello verticale sono uno sull'altro */
      transition: opacity var(--dur) var(--ease) calc(var(--dur-slow) * 0.9);
    }
    .lamelle__lamella[data-attiva] .lamelle__spina {
      opacity: 0;
      transition-delay: 0s;
    }

    .lamelle__numero {
      top: var(--s-5);
      left: var(--s-5);
    }
    /* sulla lamella stretta il numero sta al centro, sopra il nome verticale */
    .lamelle__lamella:not([data-attiva]) .lamelle__numero {
      left: 50%;
      transform: translateX(-50%);
    }

    .lamelle__didascalia {
      bottom: var(--s-6);
      left: var(--s-6);
      max-width: 16rem;
      opacity: 0;
      transform: translateY(12px);
      transition:
        opacity var(--dur) var(--ease),
        transform var(--dur) var(--ease);
    }
    .lamelle__lamella[data-attiva] .lamelle__didascalia {
      opacity: 1;
      transform: none;
      /* compare a lamella aperta, non mentre si apre */
      transition-delay: calc(var(--dur-slow) * 0.8);
    }
    /* Il rosso vuol dire "questa qui": sotto il nome della lamella aperta. */
    .lamelle__nome {
      transition: border-color var(--dur) var(--ease);
    }
    .lamelle__lamella[data-attiva] .lamelle__nome {
      border-bottom-color: var(--c-brand);
    }
  }

  /* ------------------------------------------------------------- ingresso
     Le lamelle salgono una dopo l'altra quando la galleria entra nella
     finestra. La classe la mette lo script: senza, è tutto già visibile. */
  @media (prefers-reduced-motion: no-preference) {
    .lamelle--anim .lamelle__lamella {
      opacity: 0;
      translate: 0 2.5rem;
    }
    .lamelle--anim.lamelle--visibile .lamelle__lamella {
      opacity: 1;
      translate: 0 0;
      transition:
        flex-grow calc(var(--dur-slow) * 1.5) var(--ease),
        opacity 700ms var(--ease) calc(var(--i) * 60ms),
        translate 700ms var(--ease) calc(var(--i) * 60ms);
    }
  }

  /* ---------------------------------------------------------------- lightbox */
  .lightbox {
    width: min(100vw, 100%);
    max-width: none;
    height: 100%;
    max-height: none;
    padding: 0;
    color: var(--c-white);
    background: rgb(0 0 0 / 92%);
    border: 0;
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 92%);
  }
  .lightbox__figure {
    display: grid;
    gap: var(--s-4);
    place-content: center;
    height: 100%;
    margin: 0;
    padding: var(--s-12) var(--s-15);
  }
  .lightbox__img {
    max-width: 100%;
    max-height: 80vh;
    margin-inline: auto;
    object-fit: contain;
  }
  .lightbox__caption {
    color: var(--c-white);
    font-size: var(--t-sm);
    text-align: center;
  }
  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    color: var(--c-white);
    appearance: none;
    background: rgb(255 255 255 / 10%);
    border: 0;
    cursor: pointer;
    transition: background-color var(--dur) var(--ease);
  }
  .lightbox__btn:hover {
    background: var(--c-brand);
  }
  .lightbox__btn--prev {
    top: 50%;
    left: var(--s-3);
    transform: translateY(-50%);
  }
  .lightbox__btn--next {
    top: 50%;
    right: var(--s-3);
    transform: translateY(-50%);
  }
  .lightbox__btn--close {
    top: var(--s-3);
    right: var(--s-3);
  }
</style>

<script>
  /**
   * Se questo script non parte, ogni lamella resta un link alla foto grande e
   * la prima resta aperta: il contenuto è raggiungibile comunque.
   */
  const avvia = (radice: HTMLElement) => {
    const lamelle = Array.from(radice.querySelectorAll<HTMLElement>('.lamelle__lamella'));
    const link = lamelle.map((l) => l.querySelector<HTMLAnchorElement>('[data-lamella]')!);
    const dialog = radice.querySelector<HTMLDialogElement>('dialog');
    if (!lamelle.length || !dialog) return;

    const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
    const didascalia = dialog.querySelector<HTMLElement>('.lightbox__caption')!;
    /* Da 992px le lamelle sono una parete che si apre; sotto, una fila. */
    const parete = window.matchMedia('(min-width: 992px)');

    let aperta = 0;
    const apri = (n: number) => {
      aperta = n;
      lamelle.forEach((l, k) => {
        l.toggleAttribute('data-attiva', k === n);
        if (k === n) link[k].setAttribute('aria-current', 'true');
        else link[k].removeAttribute('aria-current');
      });
    };

    /* Puntando una lamella con il mouse si apre dopo un attimo: attraversando
       la parete di corsa non deve aprirle tutte una dopo l'altra.
       Chiuso il lightbox il mouse è fermo sopra la lamella di prima, e il
       browser lo dichiara "entrato" appena il dialogo sparisce: senza
       `sospeso`, quella lamella si riapriva e batteva la foto appena vista.
       Si riprende a seguire il mouse solo quando si muove davvero (i movimenti
       sintetici del layout hanno `movementX` e `movementY` a zero). */
    let attesa = 0;
    let sospeso = false;
    radice.addEventListener('pointermove', (e) => {
      if (e.movementX !== 0 || e.movementY !== 0) sospeso = false;
    });
    lamelle.forEach((l, k) => {
      l.addEventListener('pointerenter', (e) => {
        if (!parete.matches || e.pointerType !== 'mouse' || sospeso) return;
        window.clearTimeout(attesa);
        attesa = window.setTimeout(() => apri(k), 90);
      });
      l.addEventListener('pointerleave', () => window.clearTimeout(attesa));
      l.addEventListener('focusin', () => {
        if (parete.matches) apri(k);
      });
    });

    /* Frecce: spostano il fuoco da una lamella all'altra, senza passare dal Tab. */
    radice.querySelector('.lamelle__fila')!.addEventListener('keydown', (e) => {
      if (!parete.matches) return;
      const tasto = (e as KeyboardEvent).key;
      const verso: Record<string, number> = { ArrowRight: aperta + 1, ArrowLeft: aperta - 1, Home: 0, End: lamelle.length - 1 };
      if (!(tasto in verso)) return;
      e.preventDefault();
      link[Math.min(Math.max(verso[tasto], 0), lamelle.length - 1)].focus();
    });

    /* Il lightbox. */
    let i = 0;
    const mostra = (n: number) => {
      i = (n + link.length) % link.length;
      const miniatura = link[i].querySelector('img');
      img.src = link[i].href;
      img.alt = miniatura?.alt ?? '';
      const nome = link[i].querySelector('.lamelle__nome')?.textContent ?? '';
      didascalia.textContent = `${nome} (${i + 1} di ${link.length})`;
    };

    link.forEach((a, k) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        /* Sulla parete, la prima volta che si tocca una lamella chiusa la si
           apre: ingrandirla subito sarebbe una sorpresa su un tablet. */
        if (parete.matches && k !== aperta) {
          apri(k);
          return;
        }
        mostra(k);
        dialog.showModal();
      }),
    );

    dialog.querySelector('.lightbox__btn--prev')!.addEventListener('click', () => mostra(i - 1));
    dialog.querySelector('.lightbox__btn--next')!.addEventListener('click', () => mostra(i + 1));
    dialog.querySelector('.lightbox__btn--close')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') mostra(i - 1);
      if (e.key === 'ArrowRight') mostra(i + 1);
    });
    /* chiudendo, il focus torna sulla lamella da cui si è partiti — e la apre */
    dialog.addEventListener('close', () => {
      sospeso = true;
      window.clearTimeout(attesa);
      apri(i);
      link[i]?.focus();
    });

    /* Quando la galleria entra nella finestra si caricano **tutte** le foto,
       anche quelle fuori dallo schermo: nella fila del telefono quelle oltre la
       quarta restavano lazy, e scorrendo si vedevano riquadri vuoti prima che
       arrivasse l'immagine. Prima di arrivare qui il lazy-load fa il suo lavoro:
       chi non scende fin qui non le scarica. */
    const caricaTutte = () =>
      radice.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((foto) => {
        foto.loading = 'eager';
      });

    /* Ingresso: le lamelle salgono una dopo l'altra quando entrano nella
       finestra. Se il browser non sa osservare, restano dove sono. */
    const fila = radice.querySelector<HTMLElement>('.lamelle__fila')!;
    if ('IntersectionObserver' in window) {
      const anima = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (anima) radice.classList.add('lamelle--anim');
      const osservatore = new IntersectionObserver(
        (voci) => {
          if (!voci[0].isIntersecting) return;
          radice.classList.add('lamelle--visibile');
          caricaTutte();
          osservatore.disconnect();
        },
        { threshold: 0.2 },
      );
      osservatore.observe(fila);
    } else {
      caricaTutte();
    }
  };

  document.querySelectorAll<HTMLElement>('[data-lamelle]').forEach(avvia);
</script>
