---
/**
 * Il fondo delle pagine di Home Design: una foto da una parte, il menu
 * scritto grande dall'altra. Prende il posto del footer del sito, che qui non
 * c'è (la landing ha un'identità sua, voce B16), ma tiene quello che un sito
 * italiano deve dire: ragione sociale, partita IVA, informativa e cookie.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { company, mappaSede, social, type Sede } from '../../data/site';

interface Props {
  foto: ImageMetadata;
  fotoAlt: string;
  /** `object-position` della foto. */
  fuoco?: string;
  /** Le voci del menu: sulla landing puntano alle sezioni, sulla pagina del QR alla landing. */
  voci: { testo: string; href: string }[];
  /** La sede del negozio: se c'è, il fondo dice dove si trova e apre Google Maps. */
  sede?: Sede;
}

const { foto, fotoAlt, fuoco = '50% 50%', voci, sede }: Props = Astro.props;
const anno = new Date().getFullYear();
---

<footer class="piede">
  <div class="piede__foto">
    <Image
      src={foto}
      alt={fotoAlt}
      widths={[640, 960, 1280]}
      sizes="(min-width: 769px) 50vw, 100vw"
      format="webp"
      quality={76}
      loading="lazy"
      decoding="async"
      style={`object-position: ${fuoco}`}
    />
  </div>

  <div class="piede__campo">
    <p class="piede__marchio">Home Design · Costruisci &amp; Arreda</p>

    <nav aria-label="Home Design">
      <ul class="piede__menu">
        {voci.map((v) => (
          <li>
            <a href={v.href}>{v.testo}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="piede__blocchi">
      {sede && (
        <div>
          <p class="piede__etichetta">Dove siamo</p>
          <p>
            <a
              href={mappaSede(sede)}
              target="_blank"
              rel="noopener"
              aria-label={`${sede.indirizzo.via}, ${sede.indirizzo.cap} ${sede.indirizzo.comune}: apri in Google Maps`}
            >
              {sede.indirizzo.via.replace(',', '')}
              <br />
              {sede.indirizzo.cap} {sede.indirizzo.comune} ({sede.indirizzo.provincia})
              <br />
              <span class="piede__mappa">Apri in Google Maps ↗</span>
            </a>
          </p>
        </div>
      )}
      <div>
        <p class="piede__etichetta">Scrivici o chiamaci</p>
        <p>
          <a href={`mailto:${company.email}`}>{company.email}</a>
          <br />
          <a href={`tel:${company.phone}`}>{company.phoneLabel}</a>
        </p>
      </div>
      <div>
        <p class="piede__etichetta">Seguici</p>
        <p>
          {social.map((s, i) => (
            <>
              <a href={s.url} rel="noopener" target="_blank">{s.nome}</a>
              {i < social.length - 1 && <br />}
            </>
          ))}
        </p>
      </div>
    </div>

    <p class="piede__legale">
      © {anno} {company.legalName} · P.IVA {company.vat}
      {' · '}<a href="/privacy-policy/">Privacy</a>
      {' · '}<a href="/cookie-policy/">Cookie</a>
      {' · '}Realizzato da{' '}
      <a href={company.realizzatoDa.url} rel="noopener">{company.realizzatoDa.nome}</a>
    </p>
  </div>
</footer>

<style>
  .piede {
    display: grid;
    background: var(--hd-navy);
  }
  @media (min-width: 769px) {
    .piede {
      grid-template-columns: 1fr 1fr;
      min-height: 88svh;
    }
  }

  .piede__foto {
    position: relative;
    min-height: 50svh;
    overflow: hidden;
  }
  .piede__foto :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .piede__campo {
    display: grid;
    align-content: start;
    gap: 40px;
    padding: 56px var(--hd-margine) 28px;
  }
  @media (min-width: 769px) {
    .piede__campo {
      grid-template-rows: auto 1fr auto auto;
      padding: 80px calc(var(--hd-margine) * 2) 28px 8%;
    }
  }

  .piede__marchio {
    font-size: var(--hd-t-piccolo);
    font-weight: 500;
  }

  .piede__menu {
    display: grid;
    gap: 14px;
  }
  .piede__menu a {
    display: inline-block;
    font-size: var(--hd-t-sotto);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.035em;
    text-decoration: none;
    transition:
      transform 220ms var(--hd-ease),
      opacity 220ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .piede__menu:hover a {
      opacity: 0.5;
    }
    .piede__menu a:hover {
      opacity: 1;
      transform: translateX(12px);
    }
  }

  .piede__blocchi {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 28px;
  }
  .piede__etichetta {
    margin-bottom: 6px !important;
    font-weight: 700;
  }
  .piede__blocchi a {
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .piede__mappa {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .piede__blocchi a:hover,
  .piede__legale a:hover {
    text-decoration: underline;
  }

  .piede__legale {
    font-size: var(--hd-t-piccolo);
    line-height: 1.6;
    color: var(--hd-rosa-tenue);
  }
  .piede__legale a {
    text-decoration: none;
  }
</style>
